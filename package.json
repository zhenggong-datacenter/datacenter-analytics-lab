{
  "name": "datacenter-capacity-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --ip 0.0.0.0 --port 8787",
    "db:setup": "wrangler d1 migrations apply capacity-db --local && wrangler d1 execute capacity-db --local --file=db/seed.sql",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && wrangler dev --local --ip 0.0.0.0 --port 8787"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}